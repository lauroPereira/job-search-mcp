# Segredos e configurações locais
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.secret
# Configuração local com parâmetros pessoais (o exemplo é config.example.toml)
config.toml

# Configurações locais dos agentes (específicas da máquina)
.claude/settings.local.json
.codex/

# Cache e temporários
*.log
*.tmp
*.bak
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Configurações específicas do Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json

# Sistema operacional
.DS_Store
Thumbs.db

# Dados reais do usuário: nunca versionar (o repositório é público)
*.db
*.sqlite
*.sqlite3
data/local/
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
!data/seed/*.csv
!tests/fixtures/**/*.csv
